{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1",
            "continue": true
        },
        {
            "src": "/(.*)\\.(jpg|jpeg|png|gif|webp|svg|ico|css|js|mp3|mp4|wav|woff|woff2|ttf)$",
            "dest": "/$1.$2",
            "continue": true
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
