{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "routes": [
        {
            "src": "/assets/(.*)",
            "dest": "/assets/$1"
        },
        {
            "src": "/(.*\\.css)",
            "continue": true
        },
        {
            "src": "/(.*\\.js)",
            "continue": true
        },
        {
            "src": "/(.*\\.jpg)",
            "continue": true
        },
        {
            "src": "/(.*\\.jpeg)",
            "continue": true
        },
        {
            "src": "/(.*\\.png)",
            "continue": true
        },
        {
            "src": "/(.*\\.mp3)",
            "continue": true
        },
        {
            "src": "/(.*\\.html)",
            "continue": true
        },
        {
            "src": "/(.*)",
            "dest": "/api/index.php"
        }
    ]
}
