{
    "functions": {
        "api/index.php": {
            "runtime": "vercel-php@0.7.4"
        }
    },
    "rewrites": [
        {
            "source": "/",
            "destination": "/api/index.php"
        },
        {
            "source": "/index.php",
            "destination": "/api/index.php"
        },
        {
            "source": "/auth/login.php",
            "destination": "/api/index.php"
        }
    ]
}
